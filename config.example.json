{
  "api_keys": {
    "fred": "REPLACE_WITH_FRED_KEY",
    "alphavantage": ""
  },
  "horizon_days": 90,
  "history_years": 12,
  "mc_paths": 20000,
  "offline": false,
  "cache_dir": ".cache",

  "return_horizons": [1, 5, 20],
  "events": ["CPI", "FOMC", "NFP", "PPI", "PCE", "UNEMPLOYMENT", "RETAIL_SALES"],

  "ewma_half_life_samples": 24,
  "fdr_alpha": 0.05,
  "enable_regime_conditioning": true,
  "enable_garch": true,
  "enable_portfolio_risk": true,
  "enable_stress_tests": true,
  "enable_backtest": true,
  "backtest_min_train": 24,

  "assets": [
    {"id": "aapl", "name": "Apple Inc.",       "class": "equity",    "yahoo": "AAPL"},
    {"id": "msft", "name": "Microsoft",        "class": "equity",    "yahoo": "MSFT"},
    {"id": "spy",  "name": "S&P 500 ETF",      "class": "etf",       "yahoo": "SPY"},
    {"id": "qqq",  "name": "Nasdaq 100 ETF",   "class": "etf",       "yahoo": "QQQ"},
    {"id": "tlt",  "name": "20Y Treasury ETF", "class": "bond",      "yahoo": "TLT"},
    {"id": "ief",  "name": "7-10Y Treasury",   "class": "bond",      "yahoo": "IEF"},
    {"id": "btc",  "name": "Bitcoin",          "class": "crypto",    "coingecko": "bitcoin",  "yahoo": "BTC-USD"},
    {"id": "eth",  "name": "Ethereum",         "class": "crypto",    "coingecko": "ethereum", "yahoo": "ETH-USD"},
    {"id": "sol",  "name": "Solana",           "class": "crypto",    "coingecko": "solana",   "yahoo": "SOL-USD"},
    {"id": "gld",  "name": "Gold ETF",         "class": "commodity", "yahoo": "GLD"},
    {"id": "slv",  "name": "Silver ETF",       "class": "commodity", "yahoo": "SLV"},
    {"id": "uso",  "name": "Oil ETF",          "class": "commodity", "yahoo": "USO"},
    {"id": "dxy",  "name": "US Dollar Index",  "class": "fx",        "yahoo": "DX-Y.NYB"}
  ],

  "portfolio": [
    {"id": "spy", "weight":  0.50},
    {"id": "tlt", "weight":  0.20},
    {"id": "gld", "weight":  0.10},
    {"id": "btc", "weight":  0.05},
    {"id": "eth", "weight":  0.05},
    {"id": "uso", "weight":  0.10}
  ],

  "structured_logging": false,
  "worker_threads": 0,
  "server": {
    "enabled": false,
    "host": "0.0.0.0",
    "port": 8080,
    "api_token": ""
  },
  "alerts": {
    "enabled": false,
    "slack_webhook": "",
    "prob_threshold": 0.20,
    "bh_q_threshold": 0.10,
    "min_sample_size": 20
  },
  "persistence": {
    "backend": "json",
    "json_dir": ".cache/runs",
    "postgres_dsn": ""
  },
  "audit": {
    "enabled": true,
    "path": ".cache/audit.log",
    "actor": "system"
  }
}
